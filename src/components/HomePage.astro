---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/posts';

interface Props { posts: Post[]; number: number; total: number }
const { posts, number, total } = Astro.props;
---
<BaseLayout title={number > 1 ? `Page ${number}` : undefined}>
  {number === 1 && (
    <section class="intro">
      <h1>Hi there 👋</h1>
      <p>My name is Dan Foster and this is my own corner of the Internet.</p>
    </section>
  )}
  <PostList posts={posts} />
  <Pagination number={number} total={total} base="/" />
</BaseLayout>
