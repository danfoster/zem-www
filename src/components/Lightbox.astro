---
// Click any diagram or image in an article to view it enlarged. Uses the native <dialog>,
// so Esc, focus handling and inertness of the page behind it are built in.
---
<dialog id="lightbox" class="lightbox" aria-label="Enlarged view">
  <div class="lightbox-stage"></div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#lightbox')!;
  const stage = dialog.querySelector<HTMLElement>('.lightbox-stage')!;

  // Zoomable things: PlantUML diagrams (inline SVG) and article images not already links.
  const isZoomable = (el: Element) => !dialog.contains(el);
  const diagramOf = (t: Element) => t.closest<HTMLElement>('figure.plantuml');
  const imageOf = (t: Element) => {
    const img = t.closest<HTMLImageElement>('.prose img, .cover img');
    return img && !img.closest('a') ? img : null;
  };

  // The largest candidate from srcset, so a resized cover opens at full quality.
  function bestSrc(img: HTMLImageElement) {
    const candidates = img.srcset
      .split(',')
      .map((s) => s.trim().split(/\s+/))
      .filter(([url, w]) => url && w?.endsWith('w'))
      .map(([url, w]) => ({ url, w: parseInt(w) }))
      .sort((a, b) => b.w - a.w);
    return candidates[0]?.url ?? img.currentSrc ?? img.src;
  }

  // Blob URL of the diagram currently shown, so it can be released on close.
  let objectUrl: string | null = null;

  function show(node: Node) {
    stage.replaceChildren(node);
    dialog.showModal();
  }

  // Fit to the window ONCE, in fixed CSS pixels. (Sizing with vw/vh would re-fit whenever the
  // page is zoomed, so browser zoom could never enlarge the picture.) Anything larger than
  // the window scrolls inside the overlay.
  function fit(img: HTMLImageElement, w: number, h: number, capHeight: boolean) {
    const scale = Math.min(1, (innerWidth * 0.92) / w, capHeight ? (innerHeight * 0.9) / h : Infinity);
    img.style.width = `${Math.round(w * scale)}px`;
  }

  // Diagrams are inline SVG on the page (so CSS can theme them), and browsers offer no
  // "open image in new tab" / "save image" for inline SVG. In the overlay, show a snapshot
  // as a real image instead, with the current theme's colours written into it.
  function openDiagram(fig: HTMLElement) {
    const live = fig.querySelector('svg');
    const vb = live?.viewBox.baseVal;
    if (!live || !vb?.width) return;

    const snapshot = live.cloneNode(true) as SVGSVGElement;
    const from = live.querySelectorAll('*');
    const to = snapshot.querySelectorAll<SVGElement>('*');
    from.forEach((el, i) => {
      const cs = getComputedStyle(el);
      to[i].style.fill = cs.fill;
      to[i].style.stroke = cs.stroke;
    });
    snapshot.removeAttribute('style');
    snapshot.removeAttribute('aria-hidden');
    // Natural size when opened on its own; it's vector, so the overlay scales it freely.
    snapshot.setAttribute('width', String(vb.width));
    snapshot.setAttribute('height', String(vb.height));
    // Opened alone in a tab, a transparent SVG would sit on the browser's own background.
    const bg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    for (const [k, v] of Object.entries({ x: vb.x, y: vb.y, width: vb.width, height: vb.height }))
      bg.setAttribute(k, String(v));
    bg.setAttribute('fill', getComputedStyle(document.body).backgroundColor);
    snapshot.prepend(bg);

    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = URL.createObjectURL(
      new Blob([new XMLSerializer().serializeToString(snapshot)], { type: 'image/svg+xml' }),
    );
    const img = new Image();
    img.alt = fig.getAttribute('aria-label') ?? 'Diagram';
    img.src = objectUrl;
    fit(img, vb.width * 2, vb.height * 2, false); // twice natural size; a tall diagram scrolls
    show(img);
  }

  function openImage(source: HTMLImageElement) {
    const big = new Image();
    big.alt = source.alt;
    big.addEventListener('load', () => fit(big, big.naturalWidth, big.naturalHeight, true));
    big.src = bestSrc(source);
    show(big);
  }

  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (!isZoomable(t)) return;
    const fig = diagramOf(t);
    if (fig) return openDiagram(fig);
    const img = imageOf(t);
    if (img) openImage(img);
  });

  // Keyboard: diagrams are focusable, so Enter/Space opens them.
  document.querySelectorAll<HTMLElement>('figure.plantuml').forEach((fig) => {
    fig.tabIndex = 0;
    fig.setAttribute('aria-haspopup', 'dialog');
    fig.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openDiagram(fig);
      }
    });
  });

  // Click anywhere to close (Esc is handled by <dialog>).
  dialog.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    stage.replaceChildren();
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = null;
  });
</script>
