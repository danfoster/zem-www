---
import { formatDate, postTags, postUrl, type Post } from '../lib/posts';

interface Props { posts: Post[] }
const { posts } = Astro.props;
const short = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<ul class="rows">
  {posts.map((post) => (
    <li>
      <a class="row" href={postUrl(post)}>
        <time datetime={post.data.date.toISOString()} title={formatDate(post.data.date)}>{short(post.data.date)}</time>
        <span class="title">
          {post.data.title}
          {post.data.description && <span class="desc">{post.data.description}</span>}
        </span>
        <span class="tags">{postTags(post).map((t) => `#${t.slug}`).join(' ')}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>
