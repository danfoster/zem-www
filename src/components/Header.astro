---
// import.meta.glob instead of getCollection: no "collection is empty" warning on every page.
const hasProjects = Object.keys(import.meta.glob('/src/content/projects/**/*.md')).length > 0;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  ...(hasProjects ? [{ href: '/projects/', label: 'Projects' }] : []),
  { href: '/post/', label: 'Blog' },
  { href: '/tags/', label: 'Tags' },
  { href: '/search/', label: 'Search' },
];
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap">
    <a class="site-title" href="/">Zem</a>
    <nav class="site-nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <button class="theme-toggle" type="button" aria-label="Toggle light/dark theme">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" /><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
      </button>
    </nav>
  </div>
</header>
<script>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
