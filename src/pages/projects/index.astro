---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projects">
  <h1 class="page-title">Projects</h1>
  {projects.length === 0 && <p>Nothing here yet.</p>}
  <ul class="rows">
    {projects.map((p) => (
      <li>
        <a class="row" href={`/projects/${p.id}/`}>
          <span class="tags">{p.data.status}</span>
          <span class="title">{p.data.title}<span class="desc">{p.data.summary}</span></span>
          <span class="tags">{p.data.tech.join(' · ')}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
