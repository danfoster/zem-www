---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title} description={project.data.summary}>
  <article>
    <header class="post-header">
      <div class="meta">
        <span>{project.data.status}{project.data.tech.length > 0 && ` · ${project.data.tech.join(', ')}`}</span>
        <ul class="taglinks">
          {project.data.repo && <li><a href={project.data.repo}>source</a></li>}
          {project.data.url && <li><a href={project.data.url}>website</a></li>}
        </ul>
      </div>
      <h1>{project.data.title}</h1>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
