---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title} description={project.data.summary}>
  <article>
    <header class="post-header">
      <h1>{project.data.title}</h1>
      <div class="meta">{project.data.status}{project.data.tech.length > 0 && ` · ${project.data.tech.join(', ')}`}</div>
      <ul class="tag-list">
        {project.data.repo && <li><a href={project.data.repo}>Source</a></li>}
        {project.data.url && <li><a href={project.data.url}>Website</a></li>}
      </ul>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
