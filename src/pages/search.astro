---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search">
  <h1 class="page-title">Search</h1>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div id="search"></div>
  <noscript>Search needs JavaScript.</noscript>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    // The index is generated by `pagefind` after `astro build`, so it doesn't exist under `astro dev`.
    if (window.PagefindUI) new PagefindUI({ element: '#search', showSubResults: true, autofocus: true });
    else document.getElementById('search').textContent = 'Search index not built yet. Run npm run build.';
  </script>
</BaseLayout>
